{
  "name": "pulso-opencode",
  "version": "0.3.0",
  "private": true,
  "description": "Adaptive delivery orchestration for OpenCode and VS Code Agents",
  "license": "UNLICENSED",
  "bin": {
    "pulso-breaker": "bin/pulso-breaker.js",
    "pulso-dashboard": "bin/pulso-dashboard.js",
    "pulso-lease": "bin/pulso-lease.js"
  },
  "files": [
    "agents/",
    "bin/",
    "commands/",
    "com.github.copilot/",
    "docs/",
    "vscode/",
    ".github/plugin/marketplace.json",
    "lib/",
    "plugins/",
    "scripts/",
    "skills/",
    "test/",
    "tools/",
    "README.md",
    "mcp.json",
    "model-profiles.json",
    "opencode.example.jsonc",
    "plugin.json",
    "pulso.manifest.json"
  ],
  "scripts": {
    "bootstrap": "node scripts/sync.mjs export --force",
    "install:local": "node scripts/setup.mjs install",
    "install:local:force": "node scripts/setup.mjs install --force",
    "install:opencode": "node scripts/setup.mjs install --target opencode",
    "install:vscode": "node scripts/setup.mjs install --target vscode",
    "uninstall:opencode": "node scripts/setup.mjs uninstall --target opencode",
    "uninstall:vscode": "node scripts/setup.mjs uninstall --target vscode",
    "uninstall:local": "node scripts/setup.mjs uninstall",
    "dashboard": "node bin/pulso-dashboard.js --open",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/plugin": "1.18.2",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
