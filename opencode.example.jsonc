{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pulso",
  "plugin": [
    "./plugins/pulso-circuit-breaker.mjs",
    "./plugins/pulso-experience-engine.mjs"
  ],
  "agent": {
    "pulso": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-planner": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-challenger": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-experience-curator": { "model": "github-copilot/gpt-5.6-luna" },
    "pulso-delivery-reporter": { "model": "github-copilot/gpt-5.6-luna" },
    "pulso-explorer": { "model": "github-copilot/gpt-5.6-luna" },
    "pulso-executor": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-verifier": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-security-auditor": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-ui-auditor": { "model": "github-copilot/gpt-5.6-terra" },
    "pulso-integration-auditor": { "model": "github-copilot/gpt-5.6-terra" }
  }
}
