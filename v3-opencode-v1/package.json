{
  "name": "pulso",
  "version": "3.0.4",
  "private": true,
  "description": "Tools semánticas y orquestación nativa para OpenCode v1; core local, sin runtime propio.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:pulso": "node install.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "uninstall:pulso": "node uninstall.mjs"
  },
