{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:work-create:1",
  "title": "Pulso work creation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "objective", "criterion", "verification"],
  "properties": {
    "workId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "criterion": {"type": "string", "minLength": 1, "maxLength": 4000},
    "verification": {"type": "string", "minLength": 1, "maxLength": 4000},
    "priority": {"enum": ["low", "normal", "high", "urgent"]}
  }
}
