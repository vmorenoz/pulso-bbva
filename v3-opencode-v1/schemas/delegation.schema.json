{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:delegation:1",
  "title": "Pulso delegation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "workRevision": {
      "type": "integer",
      "minimum": 1
    },
    "taskIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "minItems": 1
    },
    "agent": {
      "enum": [
        "pulso-researcher",
        "pulso-explorer",
        "pulso-planner",
        "pulso-plan-auditor",
        "pulso-executor",
        "pulso-qa-auditor",
        "pulso-security-auditor",
        "pulso-code-reviewer",
        "pulso-ui-auditor"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
      },
      "minItems": 0
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
    },
    "writeScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
      },
      "minItems": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "templateId": {
      "enum": [
        "project",
        "research",
        "exploration",
        "plan",
        "review",
        "implementation",
        "evidence",
        "ui-review",
        "spec",
        "delivery",
        "decision"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "workId",
    "workRevision",
    "taskIds",
    "agent",
    "objective",
    "inputs",
    "templateId",
    "output",
    "writeScope",
    "resources",
    "constraints",
    "acceptance",
    "questions"
  ]
}
