{
  "name": "pulso",
  "displayName": "Pulso",
  "version": "3.1.1",
  "publisher": "pulso-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/vmorenoz/pulso-bbva.git",
    "directory": "v3-vscode"
  },
  "private": true,
  "description": "Orquestación de especialistas y tools nativas de Pulso para VS Code y GitHub Copilot.",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.139.1",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "pulso",
    "copilot",
    "agents",
    "orchestration"
  ],
  "main": "./src/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pulso requiere un workspace confiable para ejecutar sus tools locales."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "El core local requiere directorios de filesystem."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pulso.openChat",
        "title": "Abrir chat",
        "category": "Pulso"
      },
      {
        "command": "pulso.selectProject",
        "title": "Seleccionar proyecto",
        "category": "Pulso"
      }
    ],
    "chatAgents": [
      {
        "path": "resources/agents/pulso.agent.md"
      },
      {
        "path": "resources/agents/pulso-researcher.agent.md"
      },
      {
        "path": "resources/agents/pulso-explorer.agent.md"
      },
      {
        "path": "resources/agents/pulso-planner.agent.md"
      },
      {
        "path": "resources/agents/pulso-plan-auditor.agent.md"
      },
      {
        "path": "resources/agents/pulso-executor.agent.md"
      },
      {
        "path": "resources/agents/pulso-qa-auditor.agent.md"
      },
      {
        "path": "resources/agents/pulso-security-auditor.agent.md"
      },
      {
        "path": "resources/agents/pulso-code-reviewer.agent.md"
      },
      {
        "path": "resources/agents/pulso-ui-auditor.agent.md"
      }
    ],
    "chatSkills": [
      {
        "path": "resources/skills/bbva-apx/SKILL.md"
      },
      {
        "path": "resources/skills/bbva-apx-testing/SKILL.md"
      },
      {
        "path": "resources/skills/bbva-cells/SKILL.md"
      },
      {
        "path": "resources/skills/bbva-cells-testing/SKILL.md"
      },
      {
        "path": "resources/skills/bbva-engineering/SKILL.md"
      },
      {
        "path": "resources/skills/pulso-init/SKILL.md"
      },
      {
        "path": "resources/skills/pulso-integration-verification/SKILL.md"
      },
      {
        "path": "resources/skills/pulso-recap/SKILL.md"
      },
      {
        "path": "resources/skills/pulso-resume/SKILL.md"
      },
      {
        "path": "resources/skills/pulso-status/SKILL.md"
      }
    ],
    "languageModelTools": [
      {
        "name": "pulso_workspace",
        "displayName": "Pulso · Workspace",
        "modelDescription": "Prepara, consulta, valida, sincroniza o recupera Pulso explícitamente. attempts/reconcile_attempts consultan telemetría sin declarar agentes vivos ni modificar Work.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pulso_workspace",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "prepare",
                "status",
                "validate",
                "sync",
                "recover",
                "attempts",
                "reconcile_attempts"
              ]
            },
            "fresh": {
              "type": "boolean"
            },
            "workId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "minLength": 1,
              "maxLength": 80
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 1
            },
            "sessionID": {
              "type": "string",
              "maxLength": 160
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "pulso_work",
        "displayName": "Pulso · Trabajo",
        "modelDescription": "Consulta o actualiza un objetivo de trabajo. create permite omitir workId; las demás acciones requieren ID explícito.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pulso_work",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "get",
                "create",
                "update",
                "block",
                "close",
                "reopen",
                "complete_map"
              ]
            },
            "workId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "maxLength": 240
            },
            "objective": {
              "type": "string",
              "maxLength": 4000
            },
            "criterion": {
              "type": "string",
              "maxLength": 2000
            },
            "verification": {
              "type": "string",
              "maxLength": 2000
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high",
                "urgent"
              ]
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 1
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "outcome": {
              "type": "string",
              "enum": [
                "done",
                "cancelled"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 4000
            },
            "limitations": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "reason": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "pulso_history",
        "displayName": "Pulso · Historial",
        "modelDescription": "Consulta cierres recientes de Pulso con resultado resumido.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pulso_history",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "minLength": 1,
              "maxLength": 80
            },
            "since": {
              "type": "string"
            },
            "until": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "pulso_context",
        "displayName": "Pulso · Contexto",
        "modelDescription": "Consulta o registra contexto relevante, preferencias y aprendizajes. summary devuelve contexto, preferencias key/value/source y aprendizajes note/source del ámbito solicitado; sin scope incluye proyecto y usuario. Salida limitada a 8000 caracteres con aviso de truncación. Las preferencias de usuario se conservan entre workspaces y sesiones.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pulso_context",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "summary",
                "set_context",
                "set_preference",
                "remove_preference",
                "add_learning"
              ]
            },
            "context": {
              "type": "string",
              "maxLength": 4000
            },
            "key": {
              "type": "string",
              "maxLength": 120
            },
            "value": {
              "type": "string",
              "maxLength": 1000
            },
            "scope": {
              "type": "string",
              "enum": [
                "project",
                "user"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 2000
            },
            "source": {
              "type": "string",
              "enum": [
                "user",
                "observed",
                "delegated"
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node scripts/test-host.mjs",
    "verify": "npm run build && npm run check && npm test",
    "package": "npm run verify && node scripts/package.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
