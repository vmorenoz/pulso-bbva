{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:result:1",
  "title": "Pulso v3 result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "delegationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "workRevision": {
      "type": "integer",
      "minimum": 1
    },
    "agent": {
      "enum": [
        "pulso-researcher",
        "pulso-explorer",
        "pulso-planner",
        "pulso-plan-auditor",
        "pulso-executor",
        "pulso-qa-auditor",
        "pulso-security-auditor",
        "pulso-code-reviewer",
        "pulso-ui-auditor"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
      },
      "minItems": 0
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "evidenceRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "description",
          "status",
          "evidenceRef"
        ]
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "description",
          "reference",
          "recommendation"
        ]
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "suggestedNextStep": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "delegationId",
    "workId",
    "workRevision",
    "agent",
    "status",
    "summary",
    "artifacts",
    "changedFiles",
    "checks",
    "findings",
    "questions",
    "limitations",
    "suggestedNextStep"
  ]
}
