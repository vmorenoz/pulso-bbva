{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:state:1",
  "title": "Pulso v3 state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "focusWorkId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "blocked",
              "paused"
            ]
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high",
              "critical"
            ]
          },
          "workRevision": {
            "type": "integer",
            "minimum": 1
          },
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "done": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "done",
              "total"
            ]
          },
          "lastProgress": {
            "type": "string"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "decisionsPending": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "nextAction": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "objective",
          "path",
          "status",
          "priority",
          "workRevision",
          "cycle",
          "progress",
          "lastProgress",
          "blockers",
          "decisionsPending",
          "nextAction",
          "updatedAt"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "updatedAt",
    "focusWorkId",
    "works"
  ]
}
