{
  "name": "pulso-v4-source",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:opencode": "node scripts/build.mjs opencode",
    "build:vscode": "node scripts/build.mjs vscode",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*/*.test.mjs",
    "verify": "npm run build && npm run check && npm test && npm run verify:installer-staged",
    "package:opencode": "node scripts/package.mjs opencode",
    "package:vscode": "node scripts/package.mjs vscode",
    "verify:packages": "node --test tests/distribution/*.test.mjs",
    "install:pulso": "node installer/cli.mjs",
    "verify:installer-staged": "node tests/installer/stage-smoke.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "license": "UNLICENSED"
}
