{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"urn:pulso:v4:tool-error:1",
  "title":"Concise structured error; persistence and readiness remain in the tool envelope",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "code":{"type":"string","minLength":1},
    "message":{"type":"string","maxLength":500},
    "revision":{"type":"integer","minimum":1},
    "issueCount":{"type":"integer","minimum":1},
    "issues":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "properties":{"code":{"type":"string","minLength":1},"entity":{"type":"string","minLength":1},"message":{"type":"string","minLength":1}},
      "required":["code","entity","message"]
    }}
  },
  "required":["code","message"]
}
