{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:work-receipt:1",
  "title": "Pulso compact mutation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "workId", "revision", "status", "progress", "changes", "nextAction"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"enum": ["work.create", "work.apply", "work.close", "work.reopen"]},
    "workId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pending", "in_progress", "blocked", "paused", "done", "cancelled"]},
    "progress": {"type": "object", "additionalProperties": false, "required": ["done", "total"], "properties": {"done": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}},
    "changes": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1}},
    "nextAction": {"anyOf": [{"type": "string"}, {"type": "null"}]}
  }
}
