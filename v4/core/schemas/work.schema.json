{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:work:1",
  "title": "Pulso work",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              },
              "acceptanceMode": {"enum":["evidence","user","both"]},
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "description",
              "verification",
              "evidenceIds"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "outcome",
        "criteria"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "paused",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "decisionsPending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "nextAction": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "work",
              "spec",
              "plan",
              "research",
              "review",
              "decision",
              "delivery",
              "evidence",
              "project"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "templateVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "path",
          "templateVersion"
        ]
      },
      "minItems": 0
    },
    "completedTaskIds": {
      "description":"Tasks completed or explicitly user-approved in the current cycle; not proof of technical execution. Optional for legacy Work. Reset only on reopen.",
      "type":"array","items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "criterionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 1
          },
          "agent": {
            "anyOf": [
              {
                "enum": [
                  "pulso-researcher",
                  "pulso-explorer",
                  "pulso-planner",
                  "pulso-plan-auditor",
                  "pulso-executor",
                  "pulso-qa-auditor",
                  "pulso-security-auditor",
                  "pulso-code-reviewer",
                  "pulso-ui-auditor"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "blocked",
              "paused",
              "done",
              "cancelled"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "writeScope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
            },
            "minItems": 0
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "criterionIds",
          "agent",
          "status",
          "dependsOn",
          "writeScope",
          "resources",
          "acceptance",
          "evidenceIds",
          "summary"
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "origin": {"const":"user_acceptance"},
          "operationId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
          "decisionHash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
          "appliedRevision": {"type":"integer","minimum":1},
          "kind": {
            "enum": [
              "executed",
              "manual",
              "static",
              "not_run"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "criterionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "report": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "command": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
                    },
                    "absent": {
                      "const": true
                    }
                  },
                  "required": [
                    "path",
                    "absent"
                  ]
                }
              ]
            },
            "minItems": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "editedAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptanceBasis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ]
                },
                "minItems": 0,
                "maxItems": 50
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ]
                },
                "minItems": 0,
                "maxItems": 50
              }
            },
            "required": [
              "criteria",
              "tasks"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "checkedAt",
          "criterionIds",
          "taskIds",
          "report",
          "command",
          "cwd",
          "exitCode",
          "basis",
          "files",
          "summary"
        ]
      },
      "minItems": 0
    },
    "results": {
      "description": "Immutable historical acceptance records; original delegation and reported result are in the core-owned report. Optional for older Work files.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
          "cycle": {"type":"integer","minimum":1},
          "registeredAt": {"type":"string","format":"date-time"},
          "delegationId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
          "contractVersion": {"const":2},
          "operationId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
          "decisionHash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
          "returnId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
          "continuityId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
          "intentRevision": {"type":"integer","minimum":1},
          "appliedRevision": {"type":"integer","minimum":1},
          "requestHash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
          "report": {"type":"string","minLength":1},
          "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
          "acceptedTaskIds": {"type":"array","items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},"minItems":0},
          "acceptanceBasis": {
            "type":"object","additionalProperties":false,
            "properties": {
              "criteria":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["id","sha256"]}},
              "tasks":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["id","sha256"]}}
            },
            "required":["criteria","tasks"]
          }
        },
        "required":["id","cycle","registeredAt","delegationId","requestHash","report","sha256","acceptedTaskIds","acceptanceBasis"]
      }
    },
    "assignmentOperations": {
      "type": "array",
      "description": "Append-only atomic receipts for scoped assignment operations; absent in legacy Work.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "workId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "delegationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "continuityId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "intentRevision": {
            "type": "integer",
            "minimum": 1
          },
          "appliedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "sessionID": {
            "type": "string",
            "minLength": 1
          },
          "parentSessionID": {
            "type": "string",
            "minLength": 1
          },
          "parentCallID": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "task.progress"
                    },
                    "taskId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "in_progress",
                        "blocked",
                        "paused"
                      ]
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "type",
                    "taskId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "document.register"
                    },
                    "document": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "enum": [
                            "work",
                            "spec",
                            "plan",
                            "research",
                            "review",
                            "decision",
                            "delivery",
                            "evidence",
                            "project"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
                        },
                        "templateVersion": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "path",
                        "templateVersion"
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "type",
                    "document",
                    "sha256"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "operationId",
          "workId",
          "delegationId",
          "continuityId",
          "cycle",
          "intentRevision",
          "appliedRevision",
          "sessionID",
          "parentSessionID",
          "parentCallID",
          "agent",
          "requestHash",
          "recordedAt",
          "changes"
        ]
      }
    },
    "closure": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"const":"user_requested"},
            "userRequest": {"type":"object","description":"Validated by user-requested-closure schema and closure-readiness schema in validateWork."},
            "id": {
              "type": "string",
              "minLength": 1
            },
            "cycle": {
              "type": "integer",
              "minimum": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "outcome": {
              "enum": [
                "done",
                "cancelled"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "minItems": 0
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "id",
            "cycle",
            "at",
            "outcome",
            "summary",
            "evidenceIds",
            "limitations"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptanceChanges": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "entity": {
                "const": "criterion"
              },
              "entityId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "acceptanceMode": {"enum":["evidence","user","both"]},
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "description",
                  "verification"
                ]
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "acceptanceMode": {"enum":["evidence","user","both"]},
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "description",
                  "verification"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "decisionRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              }
            },
            "required": [
              "at",
              "entity",
              "entityId",
              "before",
              "after",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "entity": {
                "const": "task"
              },
              "entityId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {"type":"string","minLength":1},
                  "agent": {"anyOf":[{"enum":["pulso-researcher","pulso-explorer","pulso-planner","pulso-plan-auditor","pulso-executor","pulso-qa-auditor","pulso-security-auditor","pulso-code-reviewer","pulso-ui-auditor"]},{"type":"null"}]},
                  "criterionIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 1
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 0
                  },
                  "writeScope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
                    },
                    "minItems": 0
                  },
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "acceptance": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "criterionIds",
                  "dependsOn",
                  "writeScope",
                  "resources",
                  "acceptance"
                ]
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {"type":"string","minLength":1},
