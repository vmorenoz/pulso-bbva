{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:work-update:1",
  "title": "Pulso semantic work mutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workId",
    "expectedRevision",
    "actions"
  ],
  "properties": {
    "workId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "work.set_overview"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "maxItems": 30
              },
              "decisionsPending": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "maxItems": 30
              },
              "nextAction": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "priority": {
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "critical"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "blocked",
                  "paused"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "task.add"
              },
              "task": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "$id": "urn:pulso:v3:task:1",
                "title": "Pulso task",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "pattern": "\\S"
                  },
                  "criterionIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "agent": {
                    "anyOf": [
                      {
                        "enum": [
                          "pulso-researcher",
                          "pulso-explorer",
                          "pulso-planner",
                          "pulso-plan-auditor",
                          "pulso-executor",
                          "pulso-qa-auditor",
                          "pulso-security-auditor",
                          "pulso-code-reviewer",
                          "pulso-ui-auditor"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "in_progress",
                      "blocked",
                      "paused",
                      "done",
                      "cancelled"
                    ]
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "writeScope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                      "maxLength": 1000
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "acceptance": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "id",
                  "title",
                  "criterionIds",
                  "agent",
                  "status",
                  "dependsOn",
                  "writeScope",
                  "resources",
                  "acceptance",
                  "evidenceIds",
                  "summary"
                ]
              }
            },
            "required": [
              "type",
              "task"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "task.update"
              },
              "taskId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "pattern": "\\S"
                  },
                  "criterionIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "agent": {
                    "anyOf": [
                      {
                        "enum": [
                          "pulso-researcher",
                          "pulso-explorer",
                          "pulso-planner",
                          "pulso-plan-auditor",
                          "pulso-executor",
                          "pulso-qa-auditor",
                          "pulso-security-auditor",
                          "pulso-code-reviewer",
                          "pulso-ui-auditor"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "writeScope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                      "maxLength": 1000
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "acceptance": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": []
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "decisionRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              }
            },
            "required": [
              "type",
              "taskId",
              "patch"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "task.set_status"
              },
              "taskId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "blocked",
                  "paused",
                  "done",
                  "cancelled"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "required": [
              "type",
              "taskId",
              "status"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "evidence.add"
              },
              "evidence": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "$id": "urn:pulso:v3:evidence:1",
                "title": "Pulso evidence",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "kind": {
                    "enum": [
                      "executed",
                      "manual",
                      "static",
                      "not_run"
                    ]
                  },
                  "status": {
                    "enum": [
                      "pass",
                      "fail",
                      "blocked",
                      "not_run"
                    ]
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "criterionIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "taskIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "minItems": 0,
                    "maxItems": 50
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                    "maxLength": 1000
                  },
                  "command": {
                    "description": "Comando de la comprobación, no del cálculo de huellas. Para una revisión estática sin comando usa null.",
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                    "maxLength": 1000
                  },
                  "exitCode": {
                    "description": "Solo executed admite un exit code numérico. static, manual y not_run requieren null; executed con status pass requiere 0.",
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                              "maxLength": 1000
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "path",
                            "sha256"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                              "maxLength": 1000
                            },
                            "absent": {
                              "const": true
                            }
                          },
                          "required": [
                            "path",
                            "absent"
                          ]
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  "acceptanceBasis": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "criteria": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "sha256"
                          ]
                        },
                        "minItems": 0,
                        "maxItems": 50
                      },
                      "tasks": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "sha256"
                          ]
                        },
                        "minItems": 0,
                        "maxItems": 50
                      }
                    },
                    "required": [
                      "criteria",
                      "tasks"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "status",
                  "checkedAt",
                  "criterionIds",
                  "taskIds",
                  "report",
                  "command",
                  "cwd",
                  "exitCode",
                  "basis",
                  "files",
                  "summary",
                  "acceptanceBasis"
                ]
              }
            },
            "required": [
              "type",
              "evidence"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "evidence.update"
              },
              "evidenceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  "editedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "summary"
                ]
              }
            },
            "required": [
              "type",
              "evidenceId",
              "patch"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "evidence.remove"
              },
              "evidenceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              }
            },
            "required": [
              "type",
              "evidenceId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "criterion.add"
              },
              "criterion": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "acceptanceMode": {"enum":["evidence","user","both"]},
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "id",
                  "description",
                  "verification"
                ]
              }
            },
            "required": [
              "type",
              "criterion"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "criterion.update"
              },
              "acceptanceMode": {"enum":["evidence","user","both"]},
              "criterionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "decisionRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "verification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            },
            "required": [
              "type",
              "criterionId",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "criterion.remove"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              }
            },
            "required": [
              "type",
              "criterionId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "task.remove"
              },
              "taskId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              }
            },
            "required": [
              "type",
              "taskId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "document.register"
              },
              "document": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                    "maxLength": 1000
                  },
                  "templateVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "templateVersion"
                ]
              }
            },
            "required": [
              "type",
              "document"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "document.unregister"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$",
                "maxLength": 1000
              }
            },
            "required": [
              "type",
              "path"
            ]
          }
        ]
      }
    }
  }
}
