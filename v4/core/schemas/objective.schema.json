{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pulso:v3:objective:1",
  "title": "Pulso objective",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceMode": {"enum":["evidence","user","both"]},
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "description",
          "verification",
          "evidenceIds"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "outcome",
    "criteria"
  ]
}
