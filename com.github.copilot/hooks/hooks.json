{
  "version": 1,
  "hooks": {
    "SessionStart": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" SessionStart", "timeout": 5 }],
    "SubagentStart": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" SubagentStart", "timeout": 5 }],
    "PreToolUse": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" PreToolUse", "timeout": 5 }],
    "PostToolUse": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" PostToolUse", "timeout": 5 }],
    "PreCompact": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" PreCompact", "timeout": 5 }],
    "SubagentStop": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" SubagentStop", "timeout": 5 }],
    "Stop": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/vscode/pulso-hook.mjs\" Stop", "timeout": 5 }]
  }
}
