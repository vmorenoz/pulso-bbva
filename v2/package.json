{
  "name": "pulso",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:v2": "npx --yes bun@1.4.2 run packages/installer/src/cli.ts",
    "uninstall:v2": "npx --yes bun@1.4.2 run packages/installer/src/cli.ts uninstall",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test packages/*/test",
    "test:mcp": "bun test packages/capabilities-mcp/test/server.test.ts",
    "test:orchestration": "bun test packages/orchestration/test",
    "test:runtime-renderers": "bun test packages/orchestration/test/customizations.test.ts packages/orchestration/test/runtime-renderers.test.ts",
    "test:installer": "bun test packages/installer/test",
    "test:installer:opencode": "bun test packages/installer/test/opencode-installer.test.ts",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:runtime": "bun test packages/capabilities-mcp/test/runtime.test.ts",
    "test:runtime-smoke:offline": "bun test tests/runtime-smoke-harness.test.ts tests/support/native-evidence.test.ts tests/support/fixture-scope.test.ts",
    "test:opencode-bridge": "bun test packages/capabilities-mcp/test/opencode-*.test.ts",
    "test:opencode-live": "bun run tests/opencode-live.ts",
    "test:evolution:unit": "bun test packages/*/test",
    "test:evolution:integration": "bun run test:integration && bun run test:e2e && bun run test:opencode-bridge && bun run test:runtime-smoke:offline && bun test tests/evolution-v21",
    "test:evolution:live": "bun run tests/opencode-live.ts",
    "test:evolution:all": "bun run test:evolution:unit && bun run test:evolution:integration && bun run test:evolution:live",
    "build": "bun run build:orchestration && bun build apps/cli/src/index.ts packages/capabilities-mcp/src/index.ts --outdir dist --target bun",
    "build:orchestration": "bun build packages/orchestration/src/index.ts --outdir packages/orchestration/dist --target bun"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/sdk": "1.30.1",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
